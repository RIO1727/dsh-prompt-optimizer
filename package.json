{
  "name": "dsh-prompt-optimizer",
  "version": "1.0.1",
  "description": "AI prompt optimization for the DeepSeek Harness composer: a sparkle button just left of Send rewrites the draft with the conversation's own model.",
  "type": "module",
  "main": "index.js",
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "prompt",
    "prompt-engineering",
    "composer",
    "web-ui"
  ],
  "license": "MIT",
  "author": {
    "name": "RIO1727",
    "url": "https://github.com/RIO1727"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RIO1727/dsh-prompt-optimizer.git"
  },
  "homepage": "https://github.com/RIO1727/dsh-prompt-optimizer#readme",
  "bugs": {
    "url": "https://github.com/RIO1727/dsh-prompt-optimizer/issues"
  },
  "scripts": {
    "test": "node --import ./test/shim.mjs test/host.test.mjs && node test/client.test.mjs",
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "manifestVersion": 1,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
